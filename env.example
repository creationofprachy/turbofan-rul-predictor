# Host/port the API server binds to (used only if you wire these into
# uvicorn yourself; the default `uvicorn app.main:app` command does not
# read this file).
APP_HOST=0.0.0.0
APP_PORT=8000

# No external API keys are required to run this project — the ML pipeline
# and inference are fully local. This file is kept as a placeholder for
# future optional integrations (e.g. an alerting webhook).
ALERT_WEBHOOK_URL=
